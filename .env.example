# Crypto SMC Candidate Scanner Environment Config

# Optional Google Gemini API key for "Explain Setup" feature
GEMINI_API_KEY=

# Set to true for offline demo mode with deterministic simulated data
DEMO_MODE=false

# Scanner Default Settings
MIN_24H_QUOTE_VOLUME=50000000
MIN_RVOL=1.5
MIN_VOLATILITY_PCT=3.0
MIN_1H_OI_CHANGE_PCT=5.0
REFRESH_INTERVAL_SECONDS=60
