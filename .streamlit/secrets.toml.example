# Streamlit Cloud Secrets Template
# Add these in: share.streamlit.io → your app → Settings → Secrets

# Required for the "Explain Setup" Gemini AI feature
GEMINI_API_KEY = "your-google-gemini-api-key-here"

# Optional: set to "true" to run in demo mode (no live Binance data)
# DEMO_MODE = "false"

# Optional: override refresh interval (seconds)
# REFRESH_INTERVAL_SECONDS = "60"
